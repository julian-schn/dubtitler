# Copy to .env and fill in what you use. .env is gitignored.
#
# Without ANTHROPIC_API_KEY the LLM steps write their prompt to work/prompts/
# and stop, for an agent to answer. That is a supported path, not a fallback.

ANTHROPIC_API_KEY=

# Where the local Kokoro voice keeps its model files. Defaults to
# ~/.cache/dubtitler/models, shared by every clone, so this is only needed for a
# pinned or air-gapped setup.
# DUBTITLER_MODELS=

# One per cloud speech engine you enable in config.toml.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
