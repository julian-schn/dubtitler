# Job data. The template ships empty; a clone fills these and keeps them local.
media/*
work/*
out/*
!media/.gitkeep
!work/.gitkeep
!out/.gitkeep

# Downloaded TTS weights. They live in ~/.cache/subtitler/models by default so
# that clones share one copy; this covers a job-local SUBTITLER_MODELS instead.
models/

.env
.venv/
__pycache__/
*.pyc
.DS_Store
